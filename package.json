{
  "name": "@platform/paperclip-klipper",
  "version": "0.1.10",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "private": true,
  "description": "Paperclip plugin for Klipper / Moonraker 3D printers",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "postbuild": "npm run check:manifest-version",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node ./scripts/validate-manifest.mjs",
    "check:manifest-version": "node ./scripts/check-manifest-version.mjs",
    "check:source-hygiene": "node ./scripts/check-source-hygiene.mjs",
    "prepack": "npm run build && npm run validate:manifest"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "paperclip",
    "plugin",
    "connector"
  ],
  "author": "Platform",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "file:.paperclip-sdk/paperclipai-plugin-sdk-2026.428.1-fork.10.tgz",
    "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-2026.428.1-fork.10.tgz",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.3",
    "jsdom": "^29.1.1",
    "react-dom": "^19.2.6",
    "rollup": "^4.38.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
